{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HWPX Optimizer",
  "version": "0.1.7",
  "identifier": "local.hwpxoptimizer.tauri",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/src"
  },
  "app": {
    "windows": [
      {
        "title": "HWPX Optimizer",
        "width": 1120,
        "height": 820,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["binaries/hwpx-sidecar"],
    "resources": {
      "../dist/sidecar": "sidecar",
      "../../../packages/core/dist": "node_modules/@hwpx-optimizer/core/dist",
      "../../../packages/core/package.json": "node_modules/@hwpx-optimizer/core/package.json",
      "../../../node_modules/@img": "node_modules/@img",
      "../../../node_modules/@nodable": "node_modules/@nodable",
      "../../../node_modules/core-util-is": "node_modules/core-util-is",
      "../../../node_modules/fast-xml-builder": "node_modules/fast-xml-builder",
      "../../../node_modules/fast-xml-parser": "node_modules/fast-xml-parser",
      "../../../node_modules/inherits": "node_modules/inherits",
      "../../../node_modules/isarray": "node_modules/isarray",
      "../../../node_modules/jszip": "node_modules/jszip",
      "../../../node_modules/lie": "node_modules/lie",
      "../../../node_modules/pako": "node_modules/pako",
      "../../../node_modules/path-expression-matcher": "node_modules/path-expression-matcher",
      "../../../node_modules/process-nextick-args": "node_modules/process-nextick-args",
      "../../../node_modules/readable-stream": "node_modules/readable-stream",
      "../../../node_modules/safe-buffer": "node_modules/safe-buffer",
      "../../../node_modules/setimmediate": "node_modules/setimmediate",
      "../../../node_modules/sharp": "node_modules/sharp",
      "../../../node_modules/string_decoder": "node_modules/string_decoder",
      "../../../node_modules/strnum": "node_modules/strnum",
      "../../../node_modules/util-deprecate": "node_modules/util-deprecate"
    },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
