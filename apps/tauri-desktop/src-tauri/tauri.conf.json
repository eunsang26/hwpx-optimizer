{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HWPX Optimizer",
  "version": "0.1.0",
  "identifier": "local.hwpxoptimizer.tauri",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/src"
  },
  "app": {
    "windows": [
      {
        "title": "HWPX Optimizer",
        "width": 1120,
        "height": 820,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["binaries/hwpx-sidecar"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
