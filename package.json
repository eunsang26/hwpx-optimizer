{
  "name": "hwpx-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local HWPX document size optimizer",
  "author": "HWPX Optimizer contributors",
  "main": "apps/desktop/dist/main.js",
  "workspaces": [
    "apps/desktop",
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli apps/desktop && npm run desktop:assets",
    "desktop:assets": "node apps/desktop/scripts/copy-assets.mjs",
    "desktop:start": "npm run build && electron apps/desktop/dist/main.js",
    "desktop:smoke": "npm run build && electron apps/desktop/dist/main.js --smoke-test",
    "desktop:pack": "npm run build && node scripts/run-electron-builder.mjs --dir",
    "desktop:pack:win": "npm run build && node scripts/run-electron-builder.mjs --win --x64 --dir -c.win.signAndEditExecutable=false",
    "desktop:portable:win": "npm run build && node scripts/run-electron-builder.mjs --win portable --x64 -c.win.signAndEditExecutable=false",
    "desktop:dist:win": "npm run build && node scripts/run-electron-builder.mjs --win --x64",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/cli apps/desktop --pretty false",
    "release:hygiene": "node scripts/check-release-hygiene.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "release:verify-manifest": "node scripts/verify-release-manifest.mjs",
    "release:check": "npm run release:hygiene && npm test && npm run typecheck && npm run build && npm audit && npm run desktop:smoke && npm run desktop:pack && npm run desktop:pack:win",
    "release:check:win-portable": "npm run release:hygiene && npm test && npm run typecheck && npm run build && npm audit && npm run desktop:smoke && npm run desktop:portable:win && npm run release:manifest && npm run release:verify-manifest",
    "release:check:win": "npm run release:hygiene && npm test && npm run typecheck && npm run build && npm audit && npm run desktop:smoke && npm run desktop:dist:win",
    "cli": "tsx --conditions=development packages/cli/src/index.ts"
  },
  "build": {
    "appId": "local.hwpxoptimizer.app",
    "productName": "HWPX Optimizer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "apps/desktop/dist/main.js"
    },
    "files": [
      "package.json",
      "apps/desktop/dist/**/*",
      "packages/core/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.3",
    "jszip": "^3.10.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
